#!/usr/bin/env bash
set -u
set -o pipefail

MODELS=(
  "gpt-5.4-nano"
  "gpt-5.4-mini"
  "gpt-5.4"
)

QUESTIONS="data/eval_mc/musique_mc_rag/questions.csv"
INDEX_DIR="indexes/eval_mc/musique_mc_rag"
BASE_OUT="outputs/eval_mc/model_grid_musique"

LIMIT_ARG=()
if [ -n "${LIMIT:-}" ]; then
  LIMIT_ARG=(--limit "$LIMIT")
fi

model_tag () {
  echo "$1" | tr '.-' '__'
}

preflight_model () {
  local MODEL="$1"
  python - "$MODEL" <<'PY'
import sys
from direct_llm import ask_direct_llm_with_metadata

model = sys.argv[1]
try:
    result = ask_direct_llm_with_metadata(
        'Return exactly this JSON: {"answer":"A","confidence":1.0}',
        model=model,
        max_retries=0,
    )
    print(f"MODEL_OK {model} total_tokens={result.get('total_tokens')}")
except Exception as e:
    print(f"MODEL_NOT_AVAILABLE {model}: {e}")
    sys.exit(17)
PY
}

run_eval_mc () {
  local IN="$1"
  local PREFIX="$2"

  python parse_s0_outputs.py \
    --input-path "${IN}" \
    --output-path "${PREFIX}_parsed.csv"

  python evaluate_s0.py \
    --input-path "${PREFIX}_parsed.csv" \
    --output-path "${PREFIX}_evaluated.csv" \
    --summary-path "${PREFIX}_summary.json" \
    --group-summary-path "${PREFIX}_group_summary.csv"
}

for MODEL in "${MODELS[@]}"; do
  TAG="$(model_tag "$MODEL")"
  OUT="${BASE_OUT}/${TAG}"

  mkdir -p "$OUT"

  echo
  echo "================================================================================"
  echo "MODEL: $MODEL"
  echo "TAG:   $TAG"
  echo "OUT:   $OUT"
  echo "================================================================================"

  if ! preflight_model "$MODEL"; then
    echo "SKIP: $MODEL no está disponible o falló el preflight."
    continue
  fi

  echo
  echo "---- S0 direct ----"
  python run_s0_direct.py \
    --input-path "$QUESTIONS" \
    --output-path "$OUT/s0_raw.csv" \
    --model "$MODEL" \
    --save-every 1 \
    --resume \
    "${LIMIT_ARG[@]}"

  run_eval_mc "$OUT/s0_raw.csv" "$OUT/s0"

  echo
  echo "---- S1 classic RAG top-5 ----"
  python evaluation/run_s1_mc_rag.py \
    --questions-path "$QUESTIONS" \
    --index-dir "$INDEX_DIR" \
    --output-path "$OUT/s1_raw.csv" \
    --model "$MODEL" \
    --top-k 5 \
    --save-every 1 \
    --resume \
    "${LIMIT_ARG[@]}"

  run_eval_mc "$OUT/s1_raw.csv" "$OUT/s1"

  echo
  echo "---- S2 real adaptive ----"
  python evaluation/run_s2_mc_real_adaptive.py \
    --questions-path "$QUESTIONS" \
    --index-dir "$INDEX_DIR" \
    --output-path "$OUT/s2_raw.csv" \
    --model "$MODEL" \
    --top-k 5 \
    --score-threshold 0.45 \
    --min-gap 0.05 \
    --save-every 1 \
    --resume \
    "${LIMIT_ARG[@]}"

  run_eval_mc "$OUT/s2_raw.csv" "$OUT/s2"

  echo
  echo "---- S3-MC FLARE-like ----"
  python evaluation/run_s3_mc_flare_like.py \
    --questions-path "$QUESTIONS" \
    --index-dir "$INDEX_DIR" \
    --output-path "$OUT/s3_mc_raw.csv" \
    --model "$MODEL" \
    --top-k 5 \
    --confidence-threshold 0.78 \
    --score-threshold 0.45 \
    --min-gap 0.05 \
    --save-every 1 \
    --resume \
    "${LIMIT_ARG[@]}"

  run_eval_mc "$OUT/s3_mc_raw.csv" "$OUT/s3_mc"

  echo
  echo "DONE MODEL: $MODEL"
done

echo
echo "Model grid S0-S3 finished."
