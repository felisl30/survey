#!/usr/bin/env python3
from __future__ import annotations

import argparse
from collections import Counter
from pathlib import Path
from typing import Any

import pandas as pd


SYSTEMS = ["s0", "s1", "s2", "s3"]


def model_tag(model: str) -> str:
    return model.replace(".", "_").replace("-", "_").replace("/", "_")


def clean(value: Any) -> str:
    if pd.isna(value):
        return ""
    return str(value).strip()


def boolish(value: Any) -> bool:
    if isinstance(value, bool):
        return value
    text = clean(value).lower()
    return text in {"true", "1", "yes", "y", "si"}


def number(value: Any) -> float:
    return float(pd.to_numeric(pd.Series([value]), errors="coerce").iloc[0])


def result_path(model: str, system: str, s0_out_dir: Path, rag_root: Path) -> Path:
    tag = model_tag(model)
    if system == "s0":
        return s0_out_dir / f"s0_{tag}_musique_500_mc_results.csv"
    return rag_root / tag / f"{system}_evaluated.csv"


def find_correct_column(df: pd.DataFrame, system: str) -> str:
    for col in ["eval_correct", "mc_correct", "correct", "is_correct"]:
        if col in df.columns:
            return col
    raise ValueError(f"No correct column found for {system}. Columns: {list(df.columns)}")


def find_valid_column(df: pd.DataFrame) -> str | None:
    for col in ["valid_format", "mc_valid_prediction", "valid_prediction"]:
        if col in df.columns:
            return col
    return None


def load_system_frame(model: str, system: str, s0_out_dir: Path, rag_root: Path) -> pd.DataFrame | None:
    path = result_path(model, system, s0_out_dir, rag_root)
    if not path.exists():
        return None

    df = pd.read_csv(path)
    correct_col = find_correct_column(df, system)
    valid_col = find_valid_column(df)

    out = pd.DataFrame()
    out["id"] = df["id"].astype(str)
    out["model"] = model
    out["model_tag"] = model_tag(model)
    out["system"] = system
    out["answer"] = df.get("parsed_answer", df.get("final_answer", df.get("answer", ""))).map(clean)
    out["confidence"] = pd.to_numeric(df.get("parsed_confidence", df.get("final_confidence", pd.NA)), errors="coerce")
    out["correct"] = df[correct_col].map(boolish)
    out["valid"] = df[valid_col].map(boolish) if valid_col else out["answer"].isin(["A", "B", "C", "D"])
    out["input_tokens"] = pd.to_numeric(df.get("input_tokens", pd.NA), errors="coerce")
    out["output_tokens"] = pd.to_numeric(df.get("output_tokens", pd.NA), errors="coerce")
    out["total_tokens"] = pd.to_numeric(df.get("total_tokens", pd.NA), errors="coerce")
    out["latency_seconds"] = pd.to_numeric(df.get("latency_seconds", pd.NA), errors="coerce")
    out["run_error"] = df.get("error", pd.Series([""] * len(df))).map(clean).ne("")

    if system == "s2":
        out["retrieved"] = df.get("predicted_route", "").astype(str).str.lower().str.contains("retrieve")
    elif system == "s3":
        if "active_retrieval_triggered" in df.columns:
            out["retrieved"] = df["active_retrieval_triggered"].map(boolish)
        else:
            if "n_docs_retrieved" in df.columns:
        retrieved_raw = df["n_docs_retrieved"]
    else:
        retrieved_raw = pd.Series(0, index=df.index)
    out["retrieved"] = pd.to_numeric(retrieved_raw, errors="coerce").fillna(0).gt(0)
    else:
        if "n_docs_retrieved" in df.columns:
        retrieved_raw = df["n_docs_retrieved"]
    else:
        retrieved_raw = pd.Series(0, index=df.index)
    out["retrieved"] = pd.to_numeric(retrieved_raw, errors="coerce").fillna(0).gt(0)

    for col in ["original_question", "question", "A", "B", "C", "D", "gold_answer", "gold_answer_text"]:
        if col in df.columns:
            out[col] = df[col]

    return out


def build_router_table(long_df: pd.DataFrame) -> pd.DataFrame:
    metadata_cols = ["id", "model", "model_tag", "original_question", "question", "A", "B", "C", "D", "gold_answer", "gold_answer_text"]
    metadata = long_df[[c for c in metadata_cols if c in long_df.columns]].drop_duplicates(["model", "id"])

    table = metadata.copy()
    metric_cols = ["answer", "confidence", "correct", "valid", "input_tokens", "output_tokens", "total_tokens", "latency_seconds", "retrieved", "run_error"]
    for system in SYSTEMS:
        sub = long_df[long_df["system"].eq(system)][["model", "id"] + metric_cols].copy()
        sub = sub.rename(columns={col: f"{system}_{col}" for col in metric_cols})
        table = table.merge(sub, on=["model", "id"], how="left")

    return table


def option_text(row: pd.Series, choice: str) -> str:
    choice = clean(choice)
    if choice in {"A", "B", "C", "D"}:
        return clean(row.get(choice, ""))
    return ""


def choose_row(row: pd.Series, system: str) -> dict[str, Any]:
    return {
        "selected_system": system,
        "selected_answer": clean(row.get(f"{system}_answer", "")),
        "selected_correct": boolish(row.get(f"{system}_correct", False)),
        "selected_tokens": number(row.get(f"{system}_total_tokens", pd.NA)),
        "selected_latency_seconds": number(row.get(f"{system}_latency_seconds", pd.NA)),
    }


def available_systems(row: pd.Series) -> list[str]:
    out = []
    for system in SYSTEMS:
        if clean(row.get(f"{system}_answer", "")) and not pd.isna(row.get(f"{system}_total_tokens", pd.NA)):
            out.append(system)
    return out


def cheapest(row: pd.Series, systems: list[str]) -> str:
    return min(systems, key=lambda s: number(row.get(f"{s}_total_tokens", float("inf"))))


def policy_oracle_min_cost(row: pd.Series) -> dict[str, Any]:
    systems = available_systems(row)
    correct = [s for s in systems if boolish(row.get(f"{s}_correct", False))]
    chosen = cheapest(row, correct or systems)
    return choose_row(row, chosen)


def policy_agreement_min_cost(row: pd.Series) -> dict[str, Any]:
    systems = available_systems(row)
    groups: dict[str, list[str]] = {}
    for system in systems:
        groups.setdefault(clean(row.get(f"{system}_answer", "")), []).append(system)
    best_group = max(groups.values(), key=lambda vals: (len(vals), -min(number(row.get(f"{s}_total_tokens", float("inf"))) for s in vals)))
    return choose_row(row, cheapest(row, best_group))


def policy_confidence_then_cost(row: pd.Series) -> dict[str, Any]:
    systems = available_systems(row)
    chosen = max(
        systems,
        key=lambda s: (
            number(row.get(f"{s}_confidence", -1)),
            -number(row.get(f"{s}_total_tokens", float("inf"))),
        ),
    )
    return choose_row(row, chosen)


def policy_risk_aware(row: pd.Series) -> dict[str, Any]:
    systems = available_systems(row)
    if "s0" in systems and "s2" in systems and clean(row.get("s0_answer")) == clean(row.get("s2_answer")):
        return choose_row(row, cheapest(row, ["s0", "s2"]))
    if "s1" in systems and "s3" in systems and clean(row.get("s1_answer")) == clean(row.get("s3_answer")):
        return choose_row(row, cheapest(row, ["s1", "s3"]))
    if "s3" in systems:
        return choose_row(row, "s3")
    if "s2" in systems:
        return choose_row(row, "s2")
    return choose_row(row, cheapest(row, systems))


POLICIES = {
    "oracle_min_cost": policy_oracle_min_cost,
    "agreement_min_cost": policy_agreement_min_cost,
    "confidence_then_cost": policy_confidence_then_cost,
    "risk_aware_s5": policy_risk_aware,
}


def build_policy_predictions(table: pd.DataFrame) -> pd.DataFrame:
    rows: list[dict[str, Any]] = []
    for _, row in table.iterrows():
        for policy_name, fn in POLICIES.items():
            systems = available_systems(row)
            if not systems:
                continue
            chosen = fn(row)
            out = {
                "model": row["model"],
                "model_tag": row["model_tag"],
                "id": row["id"],
                "policy": policy_name,
                "gold_answer": clean(row.get("gold_answer", "")),
                "gold_answer_text": clean(row.get("gold_answer_text", "")),
                "selected_answer_text": option_text(row, chosen["selected_answer"]),
            }
            out.update(chosen)
            rows.append(out)
    return pd.DataFrame(rows)


def summarize(preds: pd.DataFrame) -> pd.DataFrame:
    rows = []
    for (model, policy), sub in preds.groupby(["model", "policy"], dropna=False):
        selected = Counter(sub["selected_system"].astype(str))
        rows.append(
            {
                "model": model,
                "policy": policy,
                "n": int(len(sub)),
                "accuracy": float(sub["selected_correct"].mean()),
                "avg_total_tokens": float(pd.to_numeric(sub["selected_tokens"], errors="coerce").mean()),
                "avg_latency_seconds": float(pd.to_numeric(sub["selected_latency_seconds"], errors="coerce").mean()),
                "accuracy_per_1000_tokens": float(sub["selected_correct"].mean() * 1000 / pd.to_numeric(sub["selected_tokens"], errors="coerce").mean()),
                "selected_s0": selected.get("s0", 0),
                "selected_s1": selected.get("s1", 0),
                "selected_s2": selected.get("s2", 0),
                "selected_s3": selected.get("s3", 0),
            }
        )
    return pd.DataFrame(rows).sort_values(["model", "policy"])


def write_markdown(summary: pd.DataFrame, path: Path) -> None:
    lines = [
        "# MuSiQue-500 S5 Router Summary",
        "",
        "| Model | Policy | n | Accuracy | Avg tokens | Acc/1k tok | Avg latency | S0 | S1 | S2 | S3 |",
        "|---|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|",
    ]
    for _, row in summary.iterrows():
        lines.append(
            f"| {row['model']} | {row['policy']} | {int(row['n'])} | {float(row['accuracy']):.3f} | "
            f"{float(row['avg_total_tokens']):.2f} | {float(row['accuracy_per_1000_tokens']):.3f} | "
            f"{float(row['avg_latency_seconds']):.2f}s | {int(row['selected_s0'])} | {int(row['selected_s1'])} | "
            f"{int(row['selected_s2'])} | {int(row['selected_s3'])} |"
        )
    lines.extend(
        [
            "",
            "Policies:",
            "- `oracle_min_cost`: upper bound; picks the cheapest correct system when any system is correct.",
            "- `agreement_min_cost`: picks the cheapest system inside the largest answer-agreement group.",
            "- `confidence_then_cost`: picks highest reported confidence, breaking ties by lower token cost.",
            "- `risk_aware_s5`: simple deployable router: trust S0/S2 agreement, then S1/S3 agreement, else S3.",
        ]
    )
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--models", default="gpt-5-nano,gpt-5-mini,gpt-4.1-mini")
    parser.add_argument("--s0-out-dir", type=Path, default=Path("outputs/eval_mc"))
    parser.add_argument("--rag-root", type=Path, default=Path("outputs/eval_mc/musique_mc_rag_500"))
    parser.add_argument("--output-dir", type=Path, default=Path("outputs/eval_mc/musique_mc_rag_500/posthoc"))
    args = parser.parse_args()

    models = [x.strip() for x in args.models.split(",") if x.strip()]
    frames: list[pd.DataFrame] = []
    missing: list[dict[str, str]] = []

    for model in models:
        for system in SYSTEMS:
            frame = load_system_frame(model, system, args.s0_out_dir, args.rag_root)
            if frame is None:
                missing.append({"model": model, "system": system, "path": str(result_path(model, system, args.s0_out_dir, args.rag_root))})
            else:
                frames.append(frame)

    args.output_dir.mkdir(parents=True, exist_ok=True)
    pd.DataFrame(missing).to_csv(args.output_dir / "s5_missing_inputs.csv", index=False)

    if not frames:
        raise SystemExit("No S0-S3 inputs found for S5.")

    long_df = pd.concat(frames, ignore_index=True)
    table = build_router_table(long_df)
    preds = build_policy_predictions(table)
    summary = summarize(preds)

    table.to_csv(args.output_dir / "s5_router_table.csv", index=False)
    preds.to_csv(args.output_dir / "s5_policy_predictions.csv", index=False)
    summary.to_csv(args.output_dir / "s5_policy_summary.csv", index=False)
    write_markdown(summary, args.output_dir / "s5_policy_summary.md")

    print(f"S5 table:   {args.output_dir / 's5_router_table.csv'}")
    print(f"S5 summary: {args.output_dir / 's5_policy_summary.csv'}")
    if missing:
        print(f"S5 missing: {args.output_dir / 's5_missing_inputs.csv'}")


if __name__ == "__main__":
    main()
